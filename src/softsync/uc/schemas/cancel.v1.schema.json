{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "softsync.cancel.v1",
  "title": "softsync cancel signal v1",
  "type": "object",
  "required": ["schema", "id", "kind", "created_at", "producer", "contracts", "command", "sync_id", "coordinator_id", "issued_at_unix_ns", "timestamp_unix_ns", "lifecycle"],
  "properties": {
    "schema": { "const": "softsync.cancel.v1" },
    "id": { "type": "string" },
    "kind": { "const": "softsync_cancel_signal" },
    "created_at": { "type": "string" },
    "producer": { "type": "object", "required": ["project"] },
    "contracts": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "softsync.profile.local_file_sync.v1" }
    },
    "command": { "const": "cancel" },
    "sync_id": { "type": "string" },
    "coordinator_id": { "type": "string" },
    "reason": { "type": ["string", "null"] },
    "issued_at_monotonic_ns": { "type": "integer" },
    "issued_at_unix_ns": { "type": "integer" },
    "timestamp_monotonic_ns": { "type": "integer" },
    "timestamp_unix_ns": { "type": "integer" },
    "lifecycle": {
      "type": "object",
      "required": ["schema", "state", "ended_unix_ns", "closed_cleanly"],
      "properties": {
        "schema": { "const": "universal.core.lifecycle.v1" },
        "state": { "const": "cancelled" },
        "closed_cleanly": { "const": false }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
