{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "softsync.client_report.v1",
  "title": "softsync client report v1",
  "type": "object",
  "required": ["schema", "id", "kind", "created_at", "producer", "contracts", "sync_id", "client_id", "state", "timestamp_unix_ns", "timestamp_monotonic_ns", "lifecycle"],
  "properties": {
    "schema": { "enum": ["softsync.ready.v1", "softsync.active.v1", "softsync.done.v1"] },
    "id": { "type": "string" },
    "kind": { "const": "softsync_client_report" },
    "created_at": { "type": "string" },
    "producer": { "type": "object", "required": ["project"] },
    "contracts": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "softsync.profile.local_file_sync.v1" }
    },
    "sync_id": { "type": "string" },
    "client_id": { "type": "string" },
    "state": { "enum": ["ready", "active", "done"] },
    "timestamp_monotonic_ns": { "type": "integer" },
    "timestamp_unix_ns": { "type": "integer" },
    "lifecycle": {
      "type": "object",
      "required": ["schema", "state", "closed_cleanly", "error"],
      "properties": {
        "schema": { "const": "universal.core.lifecycle.v1" },
        "state": { "enum": ["prepared", "running", "closed"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
