{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "softsync.waiting_for_clients.v1",
  "title": "softsync waiting for clients request v1",
  "type": "object",
  "required": ["schema", "id", "kind", "created_at", "producer", "contracts", "command", "sync_id", "coordinator_id", "readiness_gate", "issued_at_unix_ns", "timestamp_unix_ns", "lifecycle"],
  "properties": {
    "schema": { "const": "softsync.waiting_for_clients.v1" },
    "id": { "type": "string" },
    "kind": { "const": "softsync_readiness_request" },
    "created_at": { "type": "string" },
    "producer": { "type": "object", "required": ["project"] },
    "contracts": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "softsync.profile.local_file_sync.v1" }
    },
    "command": { "const": "waiting_for_clients" },
    "sync_id": { "type": "string" },
    "coordinator_id": { "type": "string" },
    "readiness_gate": { "type": "object" },
    "issued_at_monotonic_ns": { "type": "integer" },
    "issued_at_unix_ns": { "type": "integer" },
    "timestamp_monotonic_ns": { "type": "integer" },
    "timestamp_unix_ns": { "type": "integer" },
    "lifecycle": {
      "type": "object",
      "required": ["schema", "state", "prepared_unix_ns"],
      "properties": {
        "schema": { "const": "universal.core.lifecycle.v1" },
        "state": { "const": "prepared" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
